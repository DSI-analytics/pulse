# Copy to .env and fill in.

# PostgreSQL connection string.
#  - Local dev (npm run db:dev):
#      postgresql://postgres:postgres@localhost:5433/pulso?schema=public
#  - Docker (docker compose up -d db):
#      postgresql://pulso:pulso@localhost:5432/pulso?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/pulso?schema=public"

# Secret used to sign session JWTs (min 32 chars).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Password assigned when an administrator creates or resets a user (min. 8 chars).
DEFAULT_USER_PASSWORD="change-me-now"

# Hostinger Email (SMTP outgoing server).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="geral@dsianalytics.eu"
SMTP_PASSWORD="mailbox-password"
EMAIL_FROM="Pulso <geral@dsianalytics.eu>"

# Localisation
APP_LOCALE="pt"
APP_TZ="Africa/Maputo"
APP_CURRENCY="MZN"

# Token individual usado pelo portal de demonstração. Em produção, gere um
# token aleatório por paciente e armazene apenas o respetivo hash na base.
PATIENT_API_TOKEN="pulso-demo-patient-token-2026-rotate-me"

# ─────────────────────────────────────────────────────────────────────────────
# Documentos clínicos
# ─────────────────────────────────────────────────────────────────────────────
# Directório de armazenamento dos anexos clínicos. TEM de estar FORA de /public
# — os ficheiros são entregues apenas por /api/documentos/[id], com sessão,
# permissão `document.view` e verificação de clínica. Em produção aponte para um
# volume persistente incluído na política de backup.
PULSO_UPLOAD_DIR="./var/uploads"
# Tamanho máximo por ficheiro, em MB (predefinição: 15).
PULSO_MAX_UPLOAD_MB="15"

# ─────────────────────────────────────────────────────────────────────────────
# Interoperabilidade HL7 FHIR (R4)
# ─────────────────────────────────────────────────────────────────────────────
# "false" desliga por completo a API /fhir. Qualquer outro valor (ou ausência)
# mantém-na activa — sempre autenticada, nunca pública.
FHIR_ENABLED="true"
# Base usada nos `identifier.system` dos recursos publicados. Se ficar vazio é
# usado "urn:pulso". Deve ser um URI estável e único da instituição.
FHIR_BASE_URL="https://fhir.suaclinica.mz"
# Pedidos por minuto e por cliente/utilizador na API FHIR (predefinição: 120).
FHIR_RATE_LIMIT="120"

# ─────────────────────────────────────────────────────────────────────────────
# Assistente de Insights (IA)
# ─────────────────────────────────────────────────────────────────────────────
# Sem AI_API_KEY o assistente continua a funcionar em modo determinístico
# (correspondência por palavras-chave sobre o mesmo catálogo de métricas).
# NUNCA colocar a chave real neste ficheiro nem no repositório.
AI_ENABLED="true"
AI_PROVIDER="anthropic"
AI_API_KEY=""
AI_MODEL="claude-opus-5"
# Perguntas por minuto e por utilizador (predefinição: 20).
AI_RATE_LIMIT="20"

# ─────────────────────────────────────────────────────────────────────────────
# Auditoria
# ─────────────────────────────────────────────────────────────────────────────
# Retenção recomendada dos registos de auditoria, em dias. NÃO existe expurgo
# automático: o registo é append-only e a purga, quando a legislação a permitir,
# é uma operação administrativa deliberada e documentada.
AUDIT_RETENTION_DAYS="2555"

# Origens extra autorizadas no servidor de DESENVOLVIMENTO, separadas por
# vírgulas (ex.: um nome de máquina ou um túnel). As gamas de rede local
# (192.168.*.*, 10.*.*.*, 172.16-31.*.*) e o nome desta máquina já estão
# autorizados por omissão em next.config.ts. Sem efeito em produção.
DEV_ALLOWED_ORIGINS=""
