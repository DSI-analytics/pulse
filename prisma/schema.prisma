// ─────────────────────────────────────────────────────────────────────────────
// Tenancy & identity
// ─────────────────────────────────────────────────────────────────────────────

model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  nuit      String? // Número Único de Identificação Tributária (MZ tax id)
  phone     String?
  email     String?
  address   String?
  city      String   @default("Maputo")
  country   String   @default("Moçambique")
  currency  String   @default("MZN")
  locale    String   @default("pt")
  timezone  String   @default("Africa/Maputo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches              Branch[]
  users                 User[]
  roles                 Role[]
  patients              Patient[]
  doctors               Doctor[]
  specialties           Specialty[]
  appointments          Appointment[]
  consultations         Consultation[]
  insuranceCompanies    HealthInsuranceCompany[]
  healthPlans           HealthPlan[]
  patientHealthPlans    PatientHealthPlan[]
  services              Service[]
  invoices              Invoice[]
  payments              Payment[]
  revenues              Revenue[]
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  suppliers             Supplier[]
  inventoryItems        InventoryItem[]
  inventoryCategories   InventoryCategory[]
  inventoryMovements    InventoryMovement[]
  purchases             Purchase[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  patientPortalAccesses PatientPortalAccess[]
  userAccess            UserClinicAccess[]
  identityDocuments     PatientIdentityDocument[]
  encounters            Encounter[]
  vitalSigns            VitalSign[]
  diagnoses             Diagnosis[]
  allergies             Allergy[]
  medications           Medication[]
  prescriptions         Prescription[]
  diagnosticOrders      DiagnosticOrder[]
  diagnosticResults     DiagnosticResult[]
  clinicalProcedures    ClinicalProcedure[]
  treatments            Treatment[]
  admissions            Admission[]
  clinicalAttachments   ClinicalAttachment[]
  fhirResources         FhirResource[]
  apiClients            ApiClient[]
  settings              ClinicSettings?
}

// Explicit authorisation of a user over an institution beyond their home
// clinic. A Gestor da Clínica only sees institutions listed here (plus their
// own `user.clinicId`); isolation is always enforced server-side.
model UserClinicAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, clinicId])
  @@index([clinicId])
}

model Branch {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  doctors      Doctor[]
  appointments Appointment[]
  encounters   Encounter[]

  @@index([clinicId])
}

model ClinicSettings {
  id                     String   @id @default(cuid())
  clinicId               String   @unique
  clinic                 Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  defaultSlotMinutes     Int      @default(30)
  defaultConsultationFee Int      @default(150000) // in centavos -> 1.500,00 MZN
  lowStockLeadDays       Int      @default(10)
  expiryWarningDays      Int      @default(30)
  receivableOverdueDays  Int      @default(30)
  updatedAt              DateTime @updatedAt
}

model User {
  id             String    @id @default(cuid())
  clinicId       String
  clinic         Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name           String
  email          String
  passwordHash   String
  sessionVersion Int       @default(0)
  role           UserRole
  // Optional custom role (extensibility path for tenant-defined roles).
  customRoleId   String?
  customRole     Role?     @relation(fields: [customRoleId], references: [id])
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  doctor              Doctor?
  auditLogs           AuditLog[]
  createdAppointments Appointment[]       @relation("AppointmentCreatedBy")
  passwordResetCodes  PasswordResetCode[]
  clinicAccess        UserClinicAccess[]

  createdPatients      Patient[]            @relation("PatientCreatedBy")
  createdEncounters    Encounter[]          @relation("EncounterCreatedBy")
  recordedVitalSigns   VitalSign[]          @relation("VitalSignRecordedBy")
  recordedDiagnoses    Diagnosis[]          @relation("DiagnosisRecordedBy")
  recordedAllergies    Allergy[]            @relation("AllergyRecordedBy")
  createdPrescriptions Prescription[]       @relation("PrescriptionCreatedBy")
  requestedOrders      DiagnosticOrder[]    @relation("DiagnosticOrderRequestedBy")
  validatedResults     DiagnosticResult[]   @relation("DiagnosticResultValidatedBy")
  recordedProcedures   ClinicalProcedure[]  @relation("ProcedureRecordedBy")
  createdAdmissions    Admission[]          @relation("AdmissionCreatedBy")
  uploadedAttachments  ClinicalAttachment[] @relation("AttachmentUploadedBy")
  notifications        Notification[]

  @@unique([clinicId, email])
  @@index([clinicId])
}

model PasswordResetCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Custom roles + permission catalog (architecture for future tenant-defined roles).
// The runtime permission matrix for built-in roles lives in src/lib/rbac.ts.
model Role {
  id          String   @id @default(cuid())
  clinicId    String?
  clinic      Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  permissions String[] // permission keys, see Permission
  isSystem    Boolean  @default(false)
  users       User[]

  @@unique([clinicId, key])
  @@index([clinicId])
}

model Permission {
  key         String @id
  description String
  category    String
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog: specialties, doctors, schedules
// ─────────────────────────────────────────────────────────────────────────────

model Specialty {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#0C7C74")
  createdAt DateTime @default(now())

  doctors      Doctor[]
  appointments Appointment[]
  revenues     Revenue[]
  encounters   Encounter[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model Doctor {
  id                   String       @id @default(cuid())
  clinicId             String
  clinic               Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branchId             String?
  branch               Branch?      @relation(fields: [branchId], references: [id])
  userId               String?      @unique
  user                 User?        @relation(fields: [userId], references: [id])
  specialtyId          String
  specialty            Specialty    @relation(fields: [specialtyId], references: [id])
  name                 String
  photoUrl             String?
  phone                String?
  email                String?
  licenseNumber        String? // Ordem dos Médicos registration
  consultationPrice    Int          @default(150000) // centavos
  consultationDuration Int          @default(30) // minutes
  status               DoctorStatus @default(ACTIVO)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  schedules              DoctorSchedule[]
  availabilityExceptions DoctorAvailabilityException[]
  appointments           Appointment[]
  consultations          Consultation[]
  acceptedPlans          DoctorHealthPlan[]
  revenues               Revenue[]
  encounters             Encounter[]
  diagnoses              Diagnosis[]
  allergies              Allergy[]
  prescriptions          Prescription[]
  diagnosticOrders       DiagnosticOrder[]
  clinicalProcedures     ClinicalProcedure[]
  treatments             Treatment[]
  admissions             Admission[]

  @@index([clinicId])
  @@index([clinicId, specialtyId])
}

// Weekly recurring working hours. One row per weekday the doctor works.
model DoctorSchedule {
  id          String  @id @default(cuid())
  doctorId    String
  doctor      Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  weekday     Int // 0=Sunday … 6=Saturday
  startTime   String // "08:00"
  endTime     String // "16:00"
  breakStart  String? // "12:30"
  breakEnd    String? // "13:30"
  slotMinutes Int     @default(30)

  @@unique([doctorId, weekday])
  @@index([doctorId])
}

// Date-specific overrides: holidays, time off, special hours.
model DoctorAvailabilityException {
  id        String                    @id @default(cuid())
  doctorId  String
  doctor    Doctor                    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime                  @db.Date
  type      AvailabilityExceptionType
  startTime String?
  endTime   String?
  reason    String?

  @@index([doctorId, date])
}

// Which plans a doctor accepts.
model DoctorHealthPlan {
  doctorId     String
  doctor       Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  healthPlanId String
  healthPlan   HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)

  @@id([doctorId, healthPlanId])
  @@index([healthPlanId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Patients
// ─────────────────────────────────────────────────────────────────────────────

/// Cadastro único do paciente. `code` is the human-facing patient number and is
/// unique per clinic; duplicate detection (see src/server/patient-matching.ts)
/// additionally scores name + birth date + document + phone + e-mail.
model Patient {
  id        String    @id @default(cuid())
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  code      String // human patient id, e.g. "PAC-01042"
  name      String
  birthDate DateTime? @db.Date
  gender    Gender?

  // Dados pessoais
  genderIdentity    String?
  maritalStatus     MaritalStatus?
  nationality       String?
  occupation        String?
  photoUrl          String?
  preferredLanguage String?

  // Contactos
  phone    String?
  phoneAlt String?
  email    String?

  // Endereço — `address` mantém-se como texto livre (compatibilidade).
  address          String?
  country          String?
  province         String?
  district         String?
  city             String?
  neighbourhood    String?
  street           String?
  streetNumber     String?
  addressReference String?

  // Contacto de emergência
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  emergencyContactPhoneAlt String?

  // Informação clínica geral
  bloodType         BloodType?
  chronicConditions String?
  personalHistory   String?
  surgicalHistory   String?
  familyHistory     String?
  habits            String?
  clinicalSummary   String?

  notes         String?
  /// Inactivação em vez de eliminação física (§36).
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  /// Preenchido quando este registo foi fundido noutro (deduplicação).
  mergedIntoId  String?
  mergedInto    Patient?  @relation("PatientMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    Patient[] @relation("PatientMerge")
  /// Optimistic locking — ver src/lib/concurrency.ts.
  version       Int       @default(0)

  registeredAt DateTime @default(now())
  createdById  String?
  createdBy    User?    @relation("PatientCreatedBy", fields: [createdById], references: [id])
  updatedAt    DateTime @updatedAt

  healthPlans       PatientHealthPlan[]
  appointments      Appointment[]
  consultations     Consultation[]
  invoices          Invoice[]
  payments          Payment[]
  revenues          Revenue[]
  portalAccess      PatientPortalAccess?
  identityDocuments PatientIdentityDocument[]
  encounters        Encounter[]
  vitalSigns        VitalSign[]
  diagnoses         Diagnosis[]
  allergies         Allergy[]
  prescriptions     Prescription[]
  diagnosticOrders  DiagnosticOrder[]
  procedures        ClinicalProcedure[]
  treatments        Treatment[]
  admissions        Admission[]
  attachments       ClinicalAttachment[]

  @@unique([clinicId, code])
  @@index([clinicId])
  @@index([clinicId, name])
  @@index([clinicId, phone])
  @@index([clinicId, email])
  @@index([clinicId, birthDate])
  @@index([clinicId, isActive])
}

/// Vários documentos de identificação por paciente.
model PatientIdentityDocument {
  id        String               @id @default(cuid())
  clinicId  String
  clinic    Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      IdentityDocumentType
  number    String
  issuer    String?
  issuedAt  DateTime?            @db.Date
  expiresAt DateTime?            @db.Date
  isPrimary Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([clinicId, type, number])
  @@index([patientId])
  @@index([clinicId, number])
}

model PatientPortalAccess {
  id         String    @id @default(cuid())
  clinicId   String
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId  String    @unique
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([clinicId])
  @@index([clinicId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Health insurance / plans
// ─────────────────────────────────────────────────────────────────────────────

model HealthInsuranceCompany {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name            String
  contactName     String?
  phone           String?
  email           String?
  paymentTermDays Int      @default(30)
  createdAt       DateTime @default(now())

  plans HealthPlan[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model HealthPlan {
  id                 String                 @id @default(cuid())
  clinicId           String
  clinic             Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  insuranceCompanyId String
  insuranceCompany   HealthInsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)
  name               String
  contractPrice      Int                    @default(120000) // clinic-negotiated price per consultation, centavos
  patientCopay       Int                    @default(0) // centavos paid by patient
  coverageNotes      String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())

  patientLinks PatientHealthPlan[]
  appointments Appointment[]
  invoices     Invoice[]
  doctors      DoctorHealthPlan[]
  revenues     Revenue[]

  @@unique([clinicId, insuranceCompanyId, name])
  @@index([clinicId])
}

model PatientHealthPlan {
  id               String     @id @default(cuid())
  clinicId         String
  clinic           Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  healthPlanId     String
  healthPlan       HealthPlan @relation(fields: [healthPlanId], references: [id], onDelete: Cascade)
  membershipNumber String?
  validUntil       DateTime?  @db.Date
  isPrimary        Boolean    @default(true)

  appointments Appointment[]

  @@index([clinicId])
  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Services (price list)
// ─────────────────────────────────────────────────────────────────────────────

model Service {
  id        String        @id @default(cuid())
  clinicId  String
  clinic    Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  category  String        @default("Consulta")
  source    RevenueSource @default(CONSULTA)
  basePrice Int           @default(150000) // centavos
  isActive  Boolean       @default(true)

  invoiceItems       InvoiceItem[]
  appointments       Appointment[]
  diagnosticOrders   DiagnosticOrder[]
  clinicalProcedures ClinicalProcedure[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Appointments & consultations
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id                  String             @id @default(cuid())
  clinicId            String
  clinic              Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?            @relation(fields: [branchId], references: [id])
  patientId           String
  patient             Patient            @relation(fields: [patientId], references: [id])
  doctorId            String
  doctor              Doctor             @relation(fields: [doctorId], references: [id])
  specialtyId         String
  specialty           Specialty          @relation(fields: [specialtyId], references: [id])
  patientHealthPlanId String?
  patientHealthPlan   PatientHealthPlan? @relation(fields: [patientHealthPlanId], references: [id])
  healthPlanId        String?
  healthPlan          HealthPlan?        @relation(fields: [healthPlanId], references: [id])
  isPrivate           Boolean            @default(false)
  type                AppointmentType    @default(CONSULTA)
  // Which exam / procedure is being performed (for type EXAME or PROCEDIMENTO).
  serviceId           String?
  service             Service?           @relation(fields: [serviceId], references: [id])
  status              AppointmentStatus  @default(MARCADA)
  startAt             DateTime
  endAt               DateTime
  priceQuoted         Int                @default(0) // centavos
  reason              String?
  notes               String?
  checkedInAt         DateTime?
  cancelReason        String?
  createdById         String?
  createdBy           User?              @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  encounterId         String?
  encounter           Encounter?         @relation(fields: [encounterId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  consultation Consultation?
  invoice      Invoice?
  revenue      Revenue?

  @@index([clinicId])
  @@index([clinicId, startAt])
  @@index([doctorId, startAt])
  @@index([patientId])
  @@index([clinicId, status])
}

model Consultation {
  id              String      @id @default(cuid())
  clinicId        String
  clinic          Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointmentId   String      @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient     @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor      @relation(fields: [doctorId], references: [id])
  encounterId     String?
  encounter       Encounter?  @relation(fields: [encounterId], references: [id])
  startedAt       DateTime
  endedAt         DateTime?
  subjective      String? // complaint / history
  notes           String? // clinical notes
  diagnosis       String?
  prescription    String?
  recommendations String?
  followUpDate    DateTime?   @db.Date

  // Registo clínico estruturado (SOAP alargado).
  chiefComplaint          String?
  historyOfPresentIllness String?
  symptoms                String?
  physicalExam            String?
  assessment              String?
  treatmentPlan           String?
  referrals               String?

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  vitalSigns       VitalSign[]
  diagnoses        Diagnosis[]
  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]
  attachments      ClinicalAttachment[]

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([clinicId, patientId, startedAt])
  @@index([encounterId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing: invoices, items, payments, revenue
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  number        String // "FAC-2026-000123"
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  healthPlanId  String?
  healthPlan    HealthPlan?   @relation(fields: [healthPlanId], references: [id])
  status        InvoiceStatus @default(EMITIDA)
  subtotal      Int           @default(0)
  patientDue    Int           @default(0) // centavos owed by patient
  insurerDue    Int           @default(0) // centavos owed by insurer
  total         Int           @default(0)
  amountPaid    Int           @default(0)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  createdAt     DateTime      @default(now())

  items    InvoiceItem[]
  payments Payment[]

  @@unique([clinicId, number])
  @@index([clinicId])
  @@index([clinicId, status])
  @@index([patientId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  description String
  quantity    Int      @default(1)
  unitPrice   Int // centavos
  total       Int // centavos

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  patientId     String?
  patient       Patient?      @relation(fields: [patientId], references: [id])
  amount        Int // centavos
  method        PaymentMethod
  reference     String? // M-Pesa/e-Mola tx id, etc.
  receiptNumber String?
  fromInsurer   Boolean       @default(false)
  receivedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@unique([clinicId, receiptNumber])
  @@index([clinicId])
  @@index([clinicId, receivedAt])
  @@index([invoiceId])
}

model Revenue {
  id            String         @id @default(cuid())
  clinicId      String
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  source        RevenueSource  @default(CONSULTA)
  description   String
  amount        Int // centavos
  patientId     String?
  patient       Patient?       @relation(fields: [patientId], references: [id])
  doctorId      String?
  doctor        Doctor?        @relation(fields: [doctorId], references: [id])
  specialtyId   String?
  specialty     Specialty?     @relation(fields: [specialtyId], references: [id])
  healthPlanId  String?
  healthPlan    HealthPlan?    @relation(fields: [healthPlanId], references: [id])
  appointmentId String?        @unique
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  method        PaymentMethod?
  status        PaymentStatus  @default(PAGO)
  recognisedAt  DateTime       @default(now())
  createdAt     DateTime       @default(now())

  @@index([clinicId])
  @@index([clinicId, recognisedAt])
  @@index([doctorId])
  @@index([specialtyId])
  @@index([healthPlanId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Expenses
// ─────────────────────────────────────────────────────────────────────────────

model ExpenseCategory {
  id        String    @id @default(cuid())
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model Expense {
  id          String           @id @default(cuid())
  clinicId    String
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description String
  amount      Int // centavos
  method      PaymentMethod?
  status      ExpenseStatus    @default(PAGA)
  supplierId  String?
  supplier    Supplier?        @relation(fields: [supplierId], references: [id])
  purchaseId  String?          @unique
  purchase    Purchase?        @relation(fields: [purchaseId], references: [id])
  incurredAt  DateTime         @default(now())
  dueAt       DateTime?
  createdAt   DateTime         @default(now())

  @@index([clinicId])
  @@index([clinicId, incurredAt])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Suppliers, inventory, purchases
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name            String
  category        String?
  contactName     String?
  phone           String?
  email           String?
  address         String?
  paymentTerms    String? // e.g. "30 dias"
  avgLeadTimeDays Int?
  createdAt       DateTime @default(now())

  inventoryItems InventoryItem[]
  purchases      Purchase[]
  expenses       Expense[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model InventoryCategory {
  id       String          @id @default(cuid())
  clinicId String
  clinic   Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name     String
  items    InventoryItem[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model InventoryItem {
  id                  String             @id @default(cuid())
  clinicId            String
  clinic              Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  categoryId          String?
  category            InventoryCategory? @relation(fields: [categoryId], references: [id])
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId], references: [id])
  name                String
  sku                 String
  unit                String             @default("un") // un, caixa, par, ml…
  currentStock        Int                @default(0)
  minStock            Int                @default(0)
  purchasePrice       Int                @default(0) // last purchase unit price, centavos
  avgCost             Int                @default(0) // moving average, centavos
  batchNumber         String?
  expiryDate          DateTime?          @db.Date
  lastPurchaseAt      DateTime?
  avgDailyConsumption Float              @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  movements     InventoryMovement[]
  purchaseItems PurchaseItem[]

  @@unique([clinicId, sku])
  @@index([clinicId])
  @@index([clinicId, categoryId])
}

model InventoryMovement {
  id         String                @id @default(cuid())
  clinicId   String
  clinic     Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type       InventoryMovementType
  quantity   Int // positive for ENTRADA, negative for SAIDA (normalised in service layer)
  unitCost   Int? // centavos
  reason     String?
  purchaseId String?
  purchase   Purchase?             @relation(fields: [purchaseId], references: [id])
  createdAt  DateTime              @default(now())

  @@index([clinicId])
  @@index([itemId, createdAt])
}

model Purchase {
  id            String             @id @default(cuid())
  clinicId      String
  clinic        Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  invoiceNumber String?
  status        PurchaseStatus     @default(ENCOMENDADA)
  paymentStatus PaymentTermsStatus @default(PENDENTE)
  total         Int                @default(0) // centavos
  notes         String?
  orderedAt     DateTime           @default(now())
  receivedAt    DateTime?
  dueAt         DateTime?
  createdAt     DateTime           @default(now())

  items     PurchaseItem[]
  movements InventoryMovement[]
  expense   Expense?

  @@index([clinicId])
  @@index([clinicId, orderedAt])
  @@index([supplierId])
}

model PurchaseItem {
  id         String        @id @default(cuid())
  purchaseId String
  purchase   Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  quantity   Int
  unitCost   Int // centavos
  total      Int // centavos

  @@index([purchaseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications & audit
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id                 String               @id @default(cuid())
  clinicId           String
  clinic             Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  type               NotificationType
  severity           NotificationSeverity @default(INFO)
  title              String
  body               String?
  entity             String? // "Appointment", "InventoryItem"…
  entityId           String?
  /// Destinatário específico. `null` = visível a toda a clínica, sujeito a
  /// `requiredPermission`.
  userId             String?
  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Chave de permissão necessária para ver a notificação (ex.: "laboratory.view").
  requiredPermission String?
  isRead             Boolean              @default(false)
  createdAt          DateTime             @default(now())

  @@index([clinicId, isRead])
  @@index([clinicId, createdAt])
  @@index([userId, isRead])
}

/// Append-only audit trail. A database trigger (see migration
/// `harden_audit_log_immutability`) rejects UPDATE and DELETE, so no
/// application path — soft delete included — can rewrite history.
/// Relations use `Restrict` on purpose: removing a clinic or user must not be
/// able to erase its trail.
model AuditLog {
  id         String      @id @default(cuid())
  clinicId   String
  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Denormalised actor identity — survives renames and keeps the entry readable.
  userName   String?
  userRole   UserRole?
  module     String? // "prontuario", "financeiro", "fhir", "auth"…
  action     String // "patient.create", "appointment.cancel"…
  entity     String
  entityId   String?
  /// Redacted snapshots of the record before/after the change.
  before     Json?
  after      Json?
  result     AuditResult @default(SUCESSO)
  ipAddress  String?
  userAgent  String?
  sessionId  String?
  requestId  String?
  endpoint   String?
  httpMethod String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([clinicId, createdAt])
  @@index([entity, entityId])
  @@index([clinicId, action, createdAt])
  @@index([clinicId, userId, createdAt])
  @@index([clinicId, module, createdAt])
  @@index([clinicId, result, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Episódios clínicos e registo estruturado
// ─────────────────────────────────────────────────────────────────────────────

/// Episódio clínico: agrega uma ou várias actividades (consultas, urgências,
/// exames, procedimentos, internamentos) sob o mesmo contexto assistencial.
model Encounter {
  id          String          @id @default(cuid())
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?         @relation(fields: [branchId], references: [id])
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id])
  doctorId    String?
  doctor      Doctor?         @relation(fields: [doctorId], references: [id])
  specialtyId String?
  specialty   Specialty?      @relation(fields: [specialtyId], references: [id])
  number      String
  type        EncounterType   @default(CONSULTA)
  status      EncounterStatus @default(EM_CURSO)
  startedAt   DateTime        @default(now())
  endedAt     DateTime?
  reason      String?
  summary     String?
  outcome     String?
  version     Int             @default(0)
  createdById String?
  createdBy   User?           @relation("EncounterCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  appointments     Appointment[]
  consultations    Consultation[]
  vitalSigns       VitalSign[]
  diagnoses        Diagnosis[]
  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]
  procedures       ClinicalProcedure[]
  treatments       Treatment[]
  admissions       Admission[]
  attachments      ClinicalAttachment[]

  @@unique([clinicId, number])
  @@index([clinicId, patientId, startedAt])
  @@index([clinicId, status])
  @@index([clinicId, startedAt])
  @@index([doctorId])
}

model VitalSign {
  id             String          @id @default(cuid())
  clinicId       String
  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId    String?
  encounter      Encounter?      @relation(fields: [encounterId], references: [id])
  consultationId String?
  consultation   Consultation?   @relation(fields: [consultationId], references: [id])
  admissionId    String?
  admission      Admission?      @relation(fields: [admissionId], references: [id])
  source         VitalSignSource @default(CONSULTA)
  recordedAt     DateTime        @default(now())
  recordedById   String?
  recordedBy     User?           @relation("VitalSignRecordedBy", fields: [recordedById], references: [id])

  systolic         Int? // mmHg
  diastolic        Int? // mmHg
  heartRate        Int? // bpm
  respiratoryRate  Int? // cpm
  temperature      Float? // graus Celsius
  oxygenSaturation Int? // %
  weightKg         Float?
  heightCm         Float?
  bmi              Float? // calculado a partir de peso/altura
  glucose          Float? // mg/dL
  painScore        Int? // 0-10
  /// Parametros adicionais configuraveis: { "chave": { "value": 1, "unit": "x" } }
  extra            Json?
  notes            String?

  createdAt DateTime @default(now())

  @@index([clinicId, patientId, recordedAt])
  @@index([encounterId])
  @@index([consultationId])
}

model Diagnosis {
  id             String             @id @default(cuid())
  clinicId       String
  clinic         Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId    String?
  encounter      Encounter?         @relation(fields: [encounterId], references: [id])
  consultationId String?
  consultation   Consultation?      @relation(fields: [consultationId], references: [id])
  kind           DiagnosisKind      @default(PRINCIPAL)
  certainty      DiagnosisCertainty @default(PROVISORIO)
  /// Terminologia clinica normalizada - preparado para ICD-10/CID e SNOMED CT.
  code           String?
  codeSystem     String? // "ICD-10", "SNOMED-CT", "CID-10"
  description    String
  onsetDate      DateTime?          @db.Date
  recordedAt     DateTime           @default(now())
  doctorId       String?
  doctor         Doctor?            @relation(fields: [doctorId], references: [id])
  recordedById   String?
  recordedBy     User?              @relation("DiagnosisRecordedBy", fields: [recordedById], references: [id])
  notes          String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([clinicId, patientId, recordedAt])
  @@index([clinicId, code])
  @@index([encounterId])
}

model Allergy {
  id           String          @id @default(cuid())
  clinicId     String
  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  substance    String
  /// Chave normalizada (minusculas, sem acentos) usada na verificacao de
  /// conflitos com prescricoes - ver src/lib/domain/allergy-check.ts.
  substanceKey String
  code         String?
  codeSystem   String?
  category     AllergyCategory @default(MEDICAMENTO)
  kind         AllergyKind     @default(ALERGIA)
  reaction     String?
  severity     AllergySeverity @default(MODERADA)
  status       AllergyStatus   @default(ACTIVA)
  identifiedAt DateTime?       @db.Date
  doctorId     String?
  doctor       Doctor?         @relation(fields: [doctorId], references: [id])
  recordedById String?
  recordedBy   User?           @relation("AllergyRecordedBy", fields: [recordedById], references: [id])
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([clinicId, patientId, status])
  @@index([clinicId, substanceKey])
}

/// Catalogo de medicamentos da instituicao. Alimenta a verificacao estruturada
/// entre prescricao e alergias - nunca substitui uma base farmacologica validada.
model Medication {
  id               String   @id @default(cuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name             String
  activeIngredient String?
  form             String? // comprimido, suspensao, ampola
  strength         String? // "500 mg"
  code             String?
  codeSystem       String? // "ATC", "SNOMED-CT"
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prescriptionItems PrescriptionItem[]

  @@unique([clinicId, name])
  @@index([clinicId, activeIngredient])
}

model Prescription {
  id             String             @id @default(cuid())
  clinicId       String
  clinic         Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?         @relation(fields: [encounterId], references: [id])
  consultationId String?
  consultation   Consultation?      @relation(fields: [consultationId], references: [id])
  doctorId       String?
  doctor         Doctor?            @relation(fields: [doctorId], references: [id])
  number         String
  status         PrescriptionStatus @default(ACTIVA)
  issuedAt       DateTime           @default(now())
  validUntil     DateTime?          @db.Date
  notes          String?
  /// Prescricao que esta substitui. Uma prescricao antiga nunca e apagada nem
  /// alterada silenciosamente - e suspensa e referenciada aqui (secao 5).
  replacesId     String?            @unique
  replaces       Prescription?      @relation("PrescriptionSupersede", fields: [replacesId], references: [id])
  replacedBy     Prescription?      @relation("PrescriptionSupersede")
  cancelReason   String?
  version        Int                @default(0)
  createdById    String?
  createdBy      User?              @relation("PrescriptionCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items       PrescriptionItem[]
  attachments ClinicalAttachment[]

  @@unique([clinicId, number])
  @@index([clinicId, patientId, issuedAt])
  @@index([clinicId, status])
  @@index([encounterId])
}

model PrescriptionItem {
  id               String             @id @default(cuid())
  prescriptionId   String
  prescription     Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationId     String?
  medication       Medication?        @relation(fields: [medicationId], references: [id])
  medicationName   String
  activeIngredient String?
  dose             String?
  doseUnit         String?
  route            MedicationRoute?
  frequency        String?
  durationDays     Int?
  quantity         String?
  instructions     String?
  status           PrescriptionStatus @default(ACTIVA)
  /// Alertas de alergia apresentados ao prescritor no momento da emissao.
  allergyWarnings  Json?
  createdAt        DateTime           @default(now())

  @@index([prescriptionId])
}

model DiagnosticOrder {
  id             String                @id @default(cuid())
  clinicId       String
  clinic         Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient               @relation(fields: [patientId], references: [id])
  encounterId    String?
  encounter      Encounter?            @relation(fields: [encounterId], references: [id])
  consultationId String?
  consultation   Consultation?         @relation(fields: [consultationId], references: [id])
  serviceId      String?
  service        Service?              @relation(fields: [serviceId], references: [id])
  number         String
  category       DiagnosticCategory    @default(LABORATORIO)
  name           String
  code           String?
  codeSystem     String?
  priority       DiagnosticPriority    @default(ROTINA)
  status         DiagnosticOrderStatus @default(SOLICITADO)
  requestedAt    DateTime              @default(now())
  scheduledAt    DateTime?
  collectedAt    DateTime?
  doctorId       String?
  doctor         Doctor?               @relation(fields: [doctorId], references: [id])
  requestedById  String?
  requestedBy    User?                 @relation("DiagnosticOrderRequestedBy", fields: [requestedById], references: [id])
  notes          String?
  cancelReason   String?
  version        Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  result      DiagnosticResult?
  attachments ClinicalAttachment[]

  @@unique([clinicId, number])
  @@index([clinicId, patientId, requestedAt])
  @@index([clinicId, status])
  @@index([encounterId])
}

model DiagnosticResult {
  id            String          @id @default(cuid())
  clinicId      String
  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  orderId       String          @unique
  order         DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  conclusion    String?
  notes         String?
  performedAt   DateTime?
  performedBy   String?
  validatedAt   DateTime?
  validatedById String?
  validatedBy   User?           @relation("DiagnosticResultValidatedBy", fields: [validatedById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items DiagnosticResultItem[]

  @@index([clinicId, performedAt])
}

model DiagnosticResultItem {
  id             String           @id @default(cuid())
  resultId       String
  result         DiagnosticResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  codeSystem     String?
  value          String?
  valueNumeric   Float?
  unit           String?
  referenceRange String?
  isAbnormal     Boolean          @default(false)
  flag           String? // "ALTO", "BAIXO", "CRITICO"
  notes          String?

  @@index([resultId])
}

model ClinicalProcedure {
  id            String          @id @default(cuid())
  clinicId      String
  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient         @relation(fields: [patientId], references: [id])
  encounterId   String?
  encounter     Encounter?      @relation(fields: [encounterId], references: [id])
  admissionId   String?
  admission     Admission?      @relation(fields: [admissionId], references: [id])
  serviceId     String?
  service       Service?        @relation(fields: [serviceId], references: [id])
  name          String
  code          String?
  codeSystem    String?
  status        ProcedureStatus @default(REALIZADO)
  performedAt   DateTime        @default(now())
  doctorId      String?
  doctor        Doctor?         @relation(fields: [doctorId], references: [id])
  description   String?
  outcome       String?
  complications String?
  notes         String?
  recordedById  String?
  recordedBy    User?           @relation("ProcedureRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  attachments ClinicalAttachment[]

  @@index([clinicId, patientId, performedAt])
  @@index([encounterId])
}

model Treatment {
  id          String          @id @default(cuid())
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id])
  encounterId String?
  encounter   Encounter?      @relation(fields: [encounterId], references: [id])
  name        String
  plan        String?
  startedAt   DateTime        @default(now())
  endedAt     DateTime?
  doctorId    String?
  doctor      Doctor?         @relation(fields: [doctorId], references: [id])
  status      TreatmentStatus @default(EM_CURSO)
  evolution   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([clinicId, patientId, startedAt])
  @@index([encounterId])
}

model Admission {
  id                       String          @id @default(cuid())
  clinicId                 String
  clinic                   Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId                String
  patient                  Patient         @relation(fields: [patientId], references: [id])
  encounterId              String?
  encounter                Encounter?      @relation(fields: [encounterId], references: [id])
  number                   String
  admittedAt               DateTime        @default(now())
  reason                   String?
  ward                     String?
  room                     String?
  bed                      String?
  doctorId                 String?
  doctor                   Doctor?         @relation(fields: [doctorId], references: [id])
  diagnosis                String?
  evolution                String?
  dischargedAt             DateTime?
  dischargeSummary         String?
  dischargeRecommendations String?
  status                   AdmissionStatus @default(ADMITIDO)
  version                  Int             @default(0)
  createdById              String?
  createdBy                User?           @relation("AdmissionCreatedBy", fields: [createdById], references: [id])
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  vitalSigns  VitalSign[]
  procedures  ClinicalProcedure[]
  attachments ClinicalAttachment[]

  @@unique([clinicId, number])
  @@index([clinicId, patientId, admittedAt])
  @@index([clinicId, status])
}

/// Documentos clinicos. O ficheiro nunca e servido a partir de uma URL publica:
/// o conteudo vive fora de /public e e entregue por /api/documentos/[id], que
/// revalida sessao, permissao e clinica antes de responder.
model ClinicalAttachment {
  id                String             @id @default(cuid())
  clinicId          String
  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId         String?
  patient           Patient?           @relation(fields: [patientId], references: [id])
  encounterId       String?
  encounter         Encounter?         @relation(fields: [encounterId], references: [id])
  consultationId    String?
  consultation      Consultation?      @relation(fields: [consultationId], references: [id])
  diagnosticOrderId String?
  diagnosticOrder   DiagnosticOrder?   @relation(fields: [diagnosticOrderId], references: [id])
  admissionId       String?
  admission         Admission?         @relation(fields: [admissionId], references: [id])
  procedureId       String?
  procedure         ClinicalProcedure? @relation(fields: [procedureId], references: [id])
  prescriptionId    String?
  prescription      Prescription?      @relation(fields: [prescriptionId], references: [id])

  name         String
  description  String?
  category     AttachmentCategory @default(OUTRO)
  mimeType     String
  sizeBytes    Int
  /// Caminho relativo dentro de PULSO_UPLOAD_DIR - nunca uma URL publica.
  storageKey   String             @unique
  checksum     String?
  authorName   String?
  documentDate DateTime?
  uploadedById String?
  uploadedBy   User?              @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  /// Soft delete controlado: o ficheiro sai da vista clinica mas o rasto
  /// permanece auditavel (secao 36).
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([clinicId, patientId, createdAt])
  @@index([encounterId])
  @@index([diagnosticOrderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Interoperabilidade (HL7 FHIR) e clientes de API
// ─────────────────────────────────────────────────────────────────────────────

/// Registo de identidade FHIR. Os sistemas externos nunca recebem o id interno
/// da base de dados: cada recurso exposto tem um `fhirId` proprio, estavel e
/// opaco, ligado ao modelo interno correspondente. Guarda tambem versionId /
/// lastUpdated (meta) e identificadores de sistemas terceiros.
model FhirResource {
  id                  String   @id @default(cuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  resourceType        String // "Patient", "Encounter", "Observation"
  fhirId              String
  internalModel       String // "Patient", "VitalSign", "Diagnosis"
  internalId          String
  versionId           Int      @default(1)
  lastUpdated         DateTime @default(now())
  /// Identificadores externos: [{ "system": "...", "value": "..." }]
  externalIdentifiers Json?
  createdAt           DateTime @default(now())

  @@unique([resourceType, fhirId])
  @@unique([internalModel, internalId])
  @@index([clinicId, resourceType])
  @@index([clinicId, lastUpdated])
}

/// Aplicacao externa autorizada a consumir a API FHIR. O token e guardado
/// apenas como hash SHA-256; os scopes limitam as operacoes permitidas.
model ApiClient {
  id         String    @id @default(cuid())
  clinicId   String
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  /// Scopes no espirito SMART on FHIR: "system/Patient.read", "system/*.read".
  scopes     String[]
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([clinicId, name])
  @@index([clinicId, isActive])
}

/// Tentativas de autenticacao — suporta bloqueio por forca bruta e auditoria
/// de acessos falhados sem revelar se a conta existe.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}
