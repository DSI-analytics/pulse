  PROCEDIMENTO
  EXAME
  PRODUTO
  SEGURADORA
  PRIVADO
  OUTRO
}

enum ExpenseStatus {
  PENDENTE
  PAGA
  ANULADA
}

enum PurchaseStatus {
  ENCOMENDADA
  RECEBIDA
  PARCIAL
  CANCELADA
}

enum PaymentTermsStatus {
  PENDENTE
  PARCIAL
  PAGO
}

enum InventoryMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  PERDA
